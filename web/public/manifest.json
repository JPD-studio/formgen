{
  "name": "帳票作成ソフト",
  "short_name": "FormGen",
  "description": "取引先・案件ごとに見積書・請求書・納品書を管理する帳票作成ソフト",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/yaml": [".formgen"]
      },
      "launch_type": "single-client"
    }
  ]
}
